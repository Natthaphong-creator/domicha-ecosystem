function renderFullReceipt(r,copy,logo,formatDate,formatMoney){
 const s=r.snapshot,accounting=copy==='accounting',tax=s.demo===true&&s.tax_preview,invoice=s.document_type==='ใบแจ้งหนี้',quotation=s.document_type==='ใบเสนอราคา',unpaid=invoice||quotation;
 const e=v=>String(v==null?'':v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 function words(n){const digits=['','หนึ่ง','สอง','สาม','สี่','ห้า','หก','เจ็ด','แปด','เก้า'];if(n>=1000000)return words(Math.floor(n/1000000))+'ล้าน'+(n%1000000?words(n%1000000):'');const str=String(n),place=['','สิบ','ร้อย','พัน','หมื่น','แสน'];return str.split('').map((d,i)=>{const p=str.length-i-1,v=Number(d);if(!v)return '';if(p===1)return(v===1?'':v===2?'ยี่':digits[v])+'สิบ';if(p===0&&v===1&&n>1)return 'เอ็ด';return digits[v]+place[p];}).join('');}
 const amount=s.total_satang;const amountWords=Number.isSafeInteger(amount)&&amount>=0?(amount===0?'ศูนย์บาทถ้วน':(Math.floor(amount/100)?words(Math.floor(amount/100))+'บาท':'ศูนย์บาท')+(amount%100?words(amount%100)+'สตางค์':'ถ้วน')):'—';
 const method=s.payment_method_code||(s.payment_method?.includes('เงินสด')?'cash':s.payment_method?.includes('พร้อมเพย์')?'promptpay':'transfer');
 const bank=s.seller.bank_name||'',account=s.seller.bank_account||'',reference=r.bank_reference||s.bank_reference||'—';
 const title=quotation?'ใบเสนอราคา':invoice?'ใบแจ้งหนี้':tax?'ใบเสร็จรับเงิน / ใบกำกับภาษี':'ใบเสร็จรับเงิน';
 const contents=s.package_template?.contents||{};
 const list=key=>(Array.isArray(contents[key])?contents[key]:[]).map(item=>`<li>${e(item)}</li>`).join('');
 const annex=['package','equipment','ingredients'].some(k=>Array.isArray(contents[k])&&contents[k].length)?`<section class="receipt-package-annex">${s.demo?'<div class="receipt-demo">ตัวอย่าง · ไม่ใช่เอกสารจริง</div>':''}${s.document_status==='Cancelled'?'<div class="receipt-demo">ยกเลิกแล้ว · ห้ามใช้อ้างอิง</div>':''}<h2>รายละเอียดแพ็กเกจแนบท้าย</h2><p><b>${e(s.package_template.name)}</b> · ${accounting?'สำเนา · สำหรับสำนักงานบัญชี':'ต้นฉบับ'}</p><p>แนบเอกสารเลขที่ ${e(r.number)} · ลูกค้า ${e(s.buyer_name)} · สาขา ${e(s.branch_name)}</p><p>รวมอยู่ในราคาแพ็กเกจที่แสดงในเอกสารหลัก ไม่มีราคาแยกรายชิ้น</p>${list('package')?`<div class="receipt-package-overview"><h3>สิ่งที่รวมอยู่ในแพ็กเกจ</h3><ul>${list('package')}</ul></div>`:''}<div class="receipt-package-columns"><div><h3>อุปกรณ์เปิดร้าน</h3><ol>${list('equipment')}</ol></div><div><h3>วัตถุดิบชุดเปิดร้าน</h3><ol>${list('ingredients')}</ol></div></div><p class="receipt-package-foot">รายการตามรายละเอียดแพ็กเกจ ณ วันที่ออกเอกสาร · ไม่ใช่การยืนยันส่งมอบสินค้า</p></section>`:'';
 return `<article class="receipt-paper full ${accounting?'accounting-copy':'original-copy'}">${s.demo?`<div class="receipt-demo">${tax?'ตัวอย่างสำหรับเตรียมจด VAT · ใช้อ้างอิงภาษีไม่ได้ · ไม่มีการรับเงินจริง':'ตัวอย่างรูปแบบ · ไม่ใช่ใบเสร็จจริง · ไม่มีการรับเงินจริง'}</div>`:''}${s.document_status==='Cancelled'?'<div class="receipt-demo">ยกเลิกแล้ว · ห้ามใช้อ้างอิงเรียกเก็บเงิน</div>':''}<header class="receipt-document-heading"><div><h2>${title}</h2><h3>DomiCha System</h3><p>เลขที่: ${e(r.number)} · วันที่ออกเอกสาร: ${e(formatDate(r.issued_at))}</p><p>เลขขาย / อ้างอิงคำสั่งซื้อ ${e(s.order_number)}</p>${s.quotation_number?`<p>อ้างอิงใบเสนอราคา ${e(s.quotation_number)}</p>`:''}<p class="receipt-copy-label">${accounting?'สำเนา · สำหรับสำนักงานบัญชี':'ต้นฉบับ'}</p></div><img class="receipt-logo" src="${e(logo)}" width="95" height="95" alt="โลโก้ DomiCha"></header>${s.source==='manual'?`<p class="receipt-manual-source">รายการกรอกเอง · ไม่ตัดสต๊อก${s.recorded_by?' · บันทึกโดย '+e(s.recorded_by):''}</p>`:''}<section class="receipt-party-grid"><div class="receipt-party"><h3>ผู้ขาย</h3><p>${e(s.seller.seller_name)}</p><p>${e(s.seller.seller_branch||'สำนักงานใหญ่')}</p><p>${e(s.seller.seller_address)}</p>${s.seller.seller_tax_id?`<p>เลขประจำตัวผู้เสียภาษี ${e(s.seller.seller_tax_id)}</p>`:''}${s.seller.seller_phone?`<p>โทร. ${e(s.seller.seller_phone)}</p>`:''}</div><div class="receipt-party"><h3>ลูกค้า / ผู้ชำระเงิน</h3><p>${e(s.buyer_name)}</p>${s.buyer_tax_id?`<p>เลขประจำตัวผู้เสียภาษี ${e(s.buyer_tax_id)}</p>`:''}${s.buyer_establishment?`<p>${e(s.buyer_establishment)}</p>`:''}<p>สาขา ${e(s.branch_name)}</p><p>${e(s.buyer_address||'—')}</p>${s.buyer_phone?`<p>โทร. ${e(s.buyer_phone)}</p>`:''}</div></section><table class="receipt-document-table"><thead><tr><th>#</th><th>รายการ</th><th>จำนวน</th><th>หน่วย</th><th>${tax?'ราคา/หน่วย'+(tax.price_mode==='inclusive'?' (รวม VAT)':' (ก่อน VAT)'):'ราคาต่อหน่วย'}</th><th>จำนวนเงิน</th></tr></thead><tbody>${s.items.map((i,n)=>`<tr><td>${n+1}</td><td>${e(i.name)}</td><td>${e(i.quantity)}</td><td>${e(i.unit)}</td><td>${e(formatMoney(i.price_satang))}</td><td>${e(formatMoney(i.total_satang))}</td></tr>`).join('')}</tbody></table><section class="receipt-summary-grid"><div class="receipt-amount-words"><b>จำนวนเงินตัวอักษร</b><p>${e(amountWords)}</p></div><div class="receipt-document-totals"><div><span>มูลค่าสินค้า</span><b>${e(formatMoney(s.subtotal_satang))}</b></div><div><span>ค่าจัดส่ง</span><b>${e(formatMoney(s.delivery_satang))}</b></div>${tax?`<div><span>มูลค่าก่อน VAT</span><b>${e(formatMoney(tax.base))}</b></div><div><span>VAT ${e(tax.rate)}% (อัตราสมมติ)</span><b>${e(formatMoney(tax.vat))}</b></div>`:''}<div class="receipt-grand-total"><span>ยอดสุทธิ</span><strong>${e(formatMoney(s.total_satang))}</strong></div></div></section>${unpaid?'<section class="receipt-payment-box"><h3>สถานะการชำระเงิน</h3><p>ยังไม่รับชำระ · เอกสารนี้ไม่ใช่ใบเสร็จรับเงิน</p></section>':`<section class="receipt-payment-box"><h3>ข้อมูลการชำระเงิน</h3><p class="receipt-method">${[['cash','เงินสด'],['transfer','โอนผ่านบัญชี'],['promptpay','QR พร้อมเพย์']].map(([code,label])=>`<span class="receipt-method-choice"><span class="receipt-checkbox">${method===code?'✓':'　'}</span> ${label}</span>`).join('')}</p><p>ชำระโดย ${e(s.payment_method)}</p><div class="receipt-payment-details"><div><span>ธนาคาร/บัญชี</span><p>${method==='cash'?'—':e([bank,account].filter(Boolean).join(' / ')||s.seller.account_name||'—')}</p></div><div><span>เลขอ้างอิงธนาคาร</span><p>${method==='cash'?'—':e(reference)}</p></div><div><span>วันที่รับเงิน</span><p>${e(formatDate(r.received_at))}</p></div><div><span>จำนวนเงิน</span><p>${e(formatMoney(amount))}</p></div></div><section class="receipt-signatures"><div><p>ในนาม ${e(s.buyer_name)}</p><span></span><p>ผู้จ่ายเงิน / วันที่</p></div><div><p>ในนาม ${e(s.seller.seller_name)}</p><span></span><p>ผู้รับเงิน / วันที่</p></div></section></section>`}<footer class="receipt-document-footer">${unpaid?'':'<p>ผู้ตรวจสอบ: ยืนยันรับชำระแล้ว</p>'}<p>${accounting?'สำเนาสำหรับจัดเก็บและตรวจสอบทางบัญชี อ้างอิงเลขเอกสารเดียวกับต้นฉบับ':unpaid?'ต้นฉบับสำหรับลูกค้า':'ต้นฉบับสำหรับผู้ชำระเงิน'}</p><p>${quotation?'ใบเสนอราคา · ยังไม่รับชำระ · ไม่ใช่ใบกำกับภาษี':invoice?'ใบแจ้งหนี้ · ยังไม่รับชำระ · ไม่ใช่ใบกำกับภาษี':tax?'ตัวอย่างเท่านั้น · ยังไม่เปิดออกใบกำกับภาษีจริง · อัตราและฐานภาษีต้องยืนยันก่อนเปิดใช้':'เอกสารนี้เป็นใบเสร็จรับเงิน ไม่ใช่ใบกำกับภาษี'}</p>${s.note?`<p>หมายเหตุ: ${e(s.note)}</p>`:''}<p>บันทึกจากระบบ DomiCha System</p></footer>${annex}</article>`;
}

